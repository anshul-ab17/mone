{
  "name": "server",
  "module": "index.ts",
  "type": "module",
  "private": true,

  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "bun --env-file=../../.env build src/index.ts --outdir dist",
    "test": "bun test --env-file=../../.env",
    "lint": "bunx eslint .",
    "check-types": "tsc --noEmit"
  },

  "dependencies": {
    "@prisma/client": "^7.5.0",
    "@repo/db": "*",
    "@repo/pubsub": "*",
    "@repo/types": "*",
    "@repo/config": "*",
    "argon2": "^0.44.0",
    "hono": "^4.12.9",
    "jsonwebtoken": "^9.0.3",
    "redis": "^5.11.0",
    "zod": "^4.3.6"
  },

  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^7.5.0",
    "typescript": "^5"
  }
}