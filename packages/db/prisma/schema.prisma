// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum OrderSide {
  BUY  // Bid
  SELL  // Asks
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum OrderType {
  LIMIT
  MARKET
}
 

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  createdAt DateTime @default(now())
  deletedAt DateTime?
  updatedAt DateTime @updatedAt

  orders         Order[]
  wallets        Wallet[]
  depositAddress DepositAddress?
  withdrawals    Withdrawal[]
}

model Order {
  id        String @id @default(uuid())
  userId    String
  marketId  String
  side      OrderSide
  type      OrderType
  price     Float?
  quantity  Float
  filledQty Float   @default(0)
  status    OrderStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id])
  market    Market @relation(fields: [marketId], references: [id])
  buyTrades  Trade[] @relation("BuyOrder")
  sellTrades Trade[] @relation("SellOrder")

  @@index([userId])
  @@index([marketId])
  @@index([type, price])
  @@index([marketId, side, price])
  
}

model Market {
  id    String @id @default(uuid())
  baseAsset String
  quoteAsset String

  orders Order[]

  @@unique([baseAsset, quoteAsset])
}

model Trade {
  id      String @id @default(uuid())
  buyOrderId String
  sellOrderId String
  price Float
  quantity Float
  createdAt DateTime @default(now())

  buyOrder Order @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder Order @relation("SellOrder", fields: [sellOrderId], references: [id])
}

model Wallet {
  id    String @id @default(uuid())
  userId String
  asset  String
  balance Float @default(0)
  lockedBalance  Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@unique([userId, asset])
}

// Solana on-chain withdrawal/settlement (Phase 8)
enum WithdrawalStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model Withdrawal {
  id                 String           @id @default(uuid())
  userId             String
  destinationAddress String
  amount             Float
  asset              String           @default("SOL")
  status             WithdrawalStatus @default(PENDING)
  txSignature        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

// Solana on-chain deposit support  
model DepositAddress {
  id        String   @id @default(uuid())
  userId    String   @unique
  publicKey String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ProcessedTx {
  signature String   @id
  userId    String
  amount    Float
  asset     String   @default("SOL")
  createdAt DateTime @default(now())
}
