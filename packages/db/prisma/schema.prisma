generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum OrderSide {
  BUY  // Bid
  SELL  // Asks
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum OrderType {
  LIMIT
  MARKET
}
 

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String  
  createdAt DateTime @default(now())
  deletedAt DateTime?
  updatedAt DateTime @updatedAt

  orders    Order[]
  wallets   Wallet[]
}

model Order {
  id        String @id @default(uuid())
  userId    String
  marketId  String
  side      OrderSide
  type      OrderType
  price     Float?
  quantity  Float
  filledQty Float   @default(0)
  status    OrderStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id])
  market    Market @relation(fields: [marketId], references: [id])
  buyTrades  Trade[] @relation("BuyOrder")
  sellTrades Trade[] @relation("SellOrder")

  @@index([userId])
  @@index([marketId])
  @@index([type, price])
  @@index([marketId, side, price])
  
}

model Market {
  id    String @id @default(uuid())
  baseAsset String
  quoteAsset String

  orders Order[]

  @@unique([baseAsset, quoteAsset])
}

model Trade {
  id      String @id @default(uuid())
  buyOrderId String
  sellOrderId String
  price Float
  quantity Float
  createdAt DateTime @default(now())

  buyOrder Order @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder Order @relation("SellOrder", fields: [sellOrderId], references: [id])
}

model Wallet {
  id    String @id @default(uuid())
  userId String 
  asset  String 
  balance Float @default(0)
  lockedBalance  Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@unique([userId, asset])
}
